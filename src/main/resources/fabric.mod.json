{
	"schemaVersion": 1,
	"id": "viewportcam",
	"version": "${version}",
	"name": "ViewportCam",
	"description": "类似建模软件的环绕视角，相机脱离身体绕轴心旋转/平移/缩放，并释放鼠标以在屏幕中自由移动准星。",
	"authors": [
		"wlm3201"
	],
	"license": "CC0-1.0",
	"icon": "assets/viewportcam/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.viewportcam.ViewportCamMod"
		],
		"client": [
			"com.viewportcam.client.ViewportCamClient"
		],
		"modmenu": [
			"com.viewportcam.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "viewportcam.client.mixins.json",
			"environment": "client"
		}
	],
	"suggests": {
		"yet-another-config-lib": "*",
		"modmenu": "*"
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "${minecraft_dependency}",
		"java": ">=25",
		"fabric-api": "*"
	}
}
