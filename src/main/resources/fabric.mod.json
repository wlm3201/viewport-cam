{
	"schemaVersion": 1,
	"id": "viewportcam",
	"version": "${version}",
	"name": "ViewportCam",
	"description": "A modelling-tool style orbit camera: the camera leaves the body to orbit, pan and zoom around a pivot, and frees the crosshair so it can move anywhere on screen.",
	"authors": ["wlm3201"],
	"contact": {
		"sources": "https://github.com/wlm3201/viewport-cam"
	},
	"license": "MIT",
	"icon": "assets/viewportcam/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": ["com.viewportcam.client.ViewportCamClient"],
		"modmenu": ["com.viewportcam.client.config.ModMenuIntegration"]
	},
	"mixins": [
		{
			"config": "viewportcam.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"java": ">=25",
		"minecraft": "${minecraft_dependency}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*",
		"yet_another_config_lib_v3": "*"
	}
}
